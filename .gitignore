# ---- Python ------------------------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---- test, lint and type-check caches ----------------------------------------------------------
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---- data: never committed (large; Paderborn is CC BY-NC 4.0, the 4G traces CC BY 4.0) ---------
# Only the split manifests under data/splits/ are tracked.
data/raw/
data/interim/
data/processed/

# ---- trained models, bundles, profiles: regenerate with `make folds` / `make profile` ----------
artifacts/

# ---- experiments: summaries, figures and the run registry are tracked --------------------------
# The per-cell grids are megabytes each and regenerate with `make experiments`.
experiments/e3*/results.parquet
experiments/e5*/results.parquet
experiments/**/*.npz
experiments/**/*.onnx
# Raw Docker telemetry is per-run output read by E7d; only its summary is tracked.
experiments/docker/*.msgpack
# Local edge-plane diagnostics and scratch tables (see docs/edge-work.md).
experiments/edge/

# ---- Hydra run directories ---------------------------------------------------------------------
outputs/
multirun/

# ---- notebooks: jupytext .py only --------------------------------------------------------------
*.ipynb
.ipynb_checkpoints/

# ---- DVC local state (the .dvc files themselves are tracked once a remote exists) --------------
.dvc/cache/
.dvc/tmp/

# ---- secrets and local environment -------------------------------------------------------------
.env
.env.*
!.env.example

# ---- local AI-assist tooling: per developer, not shared ----------------------------------------
.claude/
CLAUDE.md
.mcp.json
.codegraph/

# ---- editors and operating systems -------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- stray run output --------------------------------------------------------------------------
*.log
nohup.out

# ---- transfer datasets (KAI_WORK=transfer/<name>): same rules as the primary work directory -----
transfer/*/data/raw/
transfer/*/data/interim/
transfer/*/data/processed/
transfer/*/artifacts/
transfer/*/experiments/e3*/results.parquet
transfer/*/experiments/e5*/results.parquet
transfer/*/experiments/docker/*.msgpack
transfer/*/experiments/edge/
